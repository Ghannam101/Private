<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>BLANKTVPanelKey</key>
	<!-- EMPTY HERE ON PURPOSE, AND IT MUST STAY EMPTY IN THIS REPOSITORY.
	     Codemagic overwrites this at build time from the BLANKTV_APP_KEY environment
	     variable (see codemagic.yaml). The reason is the resale model: a buyer receives
	     this source, and a key committed here would hand every buyer the owner's panel
	     credential along with the app. An empty value makes PanelConfig.isConfigured
	     false, which turns the whole telemetry client off — the correct behaviour for a
	     measurement system that cannot identify itself, and it means a local build
	     never reports into the owner's live panel by accident. -->
	<string></string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>NSLocalNetworkUsageDescription</key>
	<!-- ENGLISH, and accurate. It was Arabic-only, so an English-speaking reviewer met
	     an Arabic system dialog; and it named AirPlay as the trigger, which is not what
	     fires this prompt here. The app declares no NSBonjourServices and browses no
	     mDNS. What can reach the LAN is a DIRECT connection to whatever host the user
	     typed — an IPTV server on the same network is an ordinary setup — plus AirPlay
	     route discovery. The string now says exactly that. -->
	<string>Your media server may be on this network. This app connects only to the address you enter and to AirPlay receivers you choose. It never scans the network and collects nothing about it.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
